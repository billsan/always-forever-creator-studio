{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aaf-creator-studio",
	"main": "src/index.js",
	"compatibility_date": "2026-08-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/media/*",
			"/safe-music/*",
			"/render-media/*",
			"/final/*",
			"/share/*",
			"/shared-video/*",
			"/memorial/*",
			"/obituary-writer",
			"/obituary-writer/*",
			"/test-obituary",
			"/test-obituary/*"
		]
	},
	"vars": {
		"SHOTSTACK_ENVIRONMENT": "v1",
		"OPENAI_MODEL": "gpt-5.4-mini"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aaf-creator-db",
			"database_id": "519a335f-ad87-405b-a104-5fb67143c1aa"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "aaf-creator-media"
		}
	],
	"routes": [
		{
			"pattern": "studio.alwaysandforever.life",
			"zone_name": "alwaysandforever.life",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}